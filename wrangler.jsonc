{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hal-publication-manager",
  "main": "worker/index.js",
  "workers_dev": true,
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DJANGO_DEBUG": "0",
    "DJANGO_ALLOWED_HOSTS": "hal-publication-manager.jakob-fix.workers.dev",
    "DJANGO_CSRF_TRUSTED_ORIGINS": "https://hal-publication-manager.jakob-fix.workers.dev",
    "R2_BUCKET_NAME": "hal-publication-snapshots",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "SUMMARY_USER_MINUTE_LIMIT": "3",
    "SUMMARY_USER_DAILY_LIMIT": "20",
    "SUMMARY_GLOBAL_DAILY_LIMIT": "100",
    "SUMMARY_CACHE_RETENTION_DAYS": "90"
  },
  "containers": [
    {
      "class_name": "DjangoContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DJANGO_CONTAINER",
        "class_name": "DjangoContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DjangoContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
